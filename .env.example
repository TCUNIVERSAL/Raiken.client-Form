# ═══════════════════════════════════════════════════════════════════════════════
#  Raikan Client Intake Form — Environment Configuration
#  Copy this file to .env and fill in the values. Never commit .env.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server & Client Ports ───────────────────────────────────────────────────
PORT=3005
CLIENT_PORT=5175
NODE_ENV=development

# ─── Supabase (required) ─────────────────────────────────────────────────────
# Supabase Dashboard -> Project Settings -> API Keys
SUPABASE_URL=https://your-project-id.supabase.co
# The "Secret key" (starts with sb_secret_). Used only by the backend server —
# never put it in frontend code or share it.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Optional: private storage bucket for uploaded ID documents
# (created by supabase_schema.sql; leave as is unless you renamed it)
SUPABASE_STORAGE_BUCKET=intake-documents

# ─── LiveSign (identity verification + AML) ──────────────────────────────────
# Forms are saved and wait ("pending_send") until the API key AND Partner ID are set, then go out automatically.
# API key: live-sign.com/manage/settings/apikey (sandbox: sandbox.live-sign.com/manage/settings/apikey).
# Sandbox and production keys are separate and only work with their own base URL below.
LIVESIGN_API_KEY=
# Production: https://api.web.live-sign.com
# Sandbox (test payments, no real charges): https://sandbox.api.web.live-sign.com
LIVESIGN_BASE_URL=https://sandbox.api.web.live-sign.com
# REQUIRED: Partner ID (a GUID) issued by LiveSign support (support@live-sign.com).
# Every envelope must include it; without it LiveSign rejects requests with "Invalid PartnerId provided".
LIVESIGN_PARTNER_ID=
# Envelopes are sent with payMethod "AccountHolderPays" (the firm pays on behalf of its clients),
# so the LiveSign account must have a valid payment method set up.
# AML product package (AMLWithVoi = full identity check + AML). Confirm with LiveSign for your plan.
LIVESIGN_PRODUCT_PACKAGE=AMLWithVoi
# Envelope time zone. Must be a LiveSign name from /api/Utilities/supported-timezones, e.g.
# "Cen. Australia Standard Time" (Adelaide), "AUS Eastern Standard Time" (Sydney/Melbourne),
# "E. Australia Standard Time" (Brisbane), "W. Australia Standard Time" (Perth).
LIVESIGN_TIMEZONE=Cen. Australia Standard Time
# How often pending verifications are checked with LiveSign, in seconds
LIVESIGN_POLL_SECONDS=120
# Optional: public HTTPS address of this server — enables instant LiveSign webhooks (polling still runs)
PUBLIC_BASE_URL=
# Optional: random secret added to the webhook URL so only LiveSign can call it
LIVESIGN_WEBHOOK_SECRET=

# ─── Firm notifications ──────────────────────────────────────────────────────
# Gets a copy of new forms and every verified / failed / needs-review result (comma-separate several)
FIRM_EMAIL=

# ─── Email (confirmation sent after submission) ──────────────────────────────
# If SMTP_USER is blank, emails are only logged in the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Raikan Conveyancing" <intake@raikan.com.au>
